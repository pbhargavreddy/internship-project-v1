# ── Environment variable template ────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The backend reads these at startup via python-dotenv.
#
# Works with:
#   • OpenAI          → LLM_BASE_URL=https://api.openai.com/v1
#   • Gemini (compat) → LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   • Groq            → LLM_BASE_URL=https://api.groq.com/openai/v1
#   • Ollama (local)  → LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama
# ─────────────────────────────────────────────────────────────────────────────

# Only "api" is supported. "local" (transformers Qwen) is rejected so the backend
# stays CPU-light; to run a model locally, use Ollama via LLM_BASE_URL.
LLM_PROVIDER=api

# Fine-tuned summarizer used by the agent's summarize_papers tool: an
# OpenAI-compatible server (e.g. vLLM / llama.cpp / Ollama) hosting the QLoRA model.
# Leave FINETUNED_BASE_URL empty to always fall back to the LLM above.
FINETUNED_BASE_URL=
FINETUNED_MODEL=scholarpulse
FINETUNED_API_KEY=dummy

# MongoDB for named chats and PDF backups (GridFS). Leave empty to save chats
# locally under data/chats/. Atlas example: mongodb+srv://<user>:<password>@<cluster>/
MONGODB_URI=
MONGODB_DB=scholarpulse
# CHATS_DIR=data/chats

# Thread cap for OMP / MKL / torch, applied at backend startup.
CPU_THREADS=4

LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# LLM_REASONING_EFFORT=low   # only sent to gpt-oss models (e.g. openai/gpt-oss-120b on Groq)

# Agent fallback chain, tried in order (429 / 413 / 5xx / timeouts move to the next model).
# "groq:" entries use LLM_API_KEY (and LLM_BASE_URL when it is Groq).
AGENT_MODELS=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b
# Optional second provider (OpenAI-compatible), appended to the chain only if set.
FALLBACK_BASE_URL=
FALLBACK_API_KEY=your-fallback-api-key-here
FALLBACK_MODEL=


# ── Academic web search ──────────────────────────────────────────────────────
# Optional: higher rate limit. Request one at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
# Optional overrides (defaults shown)
# SEARCH_CACHE_ENABLED=true
# SEARCH_CACHE_DIR=data/cache/search
# SEARCH_CACHE_TTL_SECONDS=86400
# HTTP_TIMEOUT_SECONDS=20
# ARXIV_DELAY_SECONDS=3
# S2_MAX_RETRIES=4


# ── RAG retrieval ────────────────────────────────────────────────────────────
# Optional overrides (defaults shown)
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# CHROMA_DIR=data/chroma
# CHROMA_COLLECTION=chunks
# RERANKER_MODEL=microsoft/MiniLM-L12-H384-uncased
# RERANKER_PATH=data/models/reranker.pt
# RERANKER_MAX_LENGTH=256
# RERANK_CANDIDATES=10
# RERANK_FUSION_K=60   # fuse vector + reranker ranks (RRF); 0 = reranker order only
# INGEST_MAX_PAPERS=2           # papers paper_search(ingest=true) indexes
# INGEST_MAX_PAGES=15           # first N pages of each paper
# EMBEDDING_BATCH_SIZE=16

# ── ReAct agent (backend/agent/) ──
# SESSIONS_DIR=data/sessions
# AGENT_MAX_STEPS=8
# AGENT_HISTORY_MESSAGES=10     # past messages of THIS chat sent to the agent (final answers only)
# AGENT_HISTORY_MAX_TOKENS=3000 # history token cap (cl100k); oldest turns dropped first
# Per-request token limits (Groq free tier: 8000 TPM, 7000 input TPM per model; prompt + max_tokens over that = 413)
# AGENT_STEP_MAX_TOKENS=1200       # max_tokens of each ReAct reply / final answer (budget + this < 8000 TPM)
# AGENT_REWRITE_MAX_TOKENS=100     # standalone-question rewrite
# AGENT_OBS_MAX_CHARS=4000         # each tool result sent back to the model
# RAG_OBS_MAX_CHARS=3000           # rag_search: top chunks up to this many chars
# AGENT_REQUEST_TOKEN_BUDGET=6000  # prompt tokens per request (trim history first, then old tool results)
# RATE_LIMIT_MAX_WAIT_S=20         # every model cooling down for <= this many s: wait once, retry (0 = never)
# AGENT_RAW_LOG=data/logs/agent_raw.log   # raw replies of steps that failed to parse
# AGENT_OUTPUT_DIR=data/plots   # python_interpreter PNGs, served at GET /plots/<file>
# PYTHON_TIMEOUT_SECONDS=15

# ── Evaluation / guardrails (backend/eval/) ──
# FAITHFULNESS_THRESHOLD=0.6     # min cosine for a sentence to count as supported
# FAITHFULNESS_WARN_BELOW=0.7    # answers scoring lower get a warning line
